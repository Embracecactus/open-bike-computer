{
  "expo": {
    "name": "Open Bike Computer",
    "slug": "open-bike-computer",
    "version": "0.2.0",
    "orientation": "portrait",
    "platforms": ["android", "ios"],
    "scheme": "openbikecomputer",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.embracecactus.openbikecomputer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "用于计算骑行速度、里程并绘制轨迹。",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "用于锁屏或切换应用后继续记录骑行轨迹。",
        "NSLocationAlwaysUsageDescription": "用于锁屏或切换应用后继续记录骑行轨迹。",
        "NSMotionUsageDescription": "用于识别骑行状态并改善轨迹记录精度。",
        "NSBluetoothAlwaysUsageDescription": "用于连接心率带、速度计和踏频传感器。",
        "UIBackgroundModes": ["location", "bluetooth-central"]
      }
    },
    "android": {
      "package": "com.embracecactus.openbikecomputer",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "BLUETOOTH_SCAN",
        "BLUETOOTH_CONNECT"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "用于计算骑行速度、里程并绘制轨迹。",
          "locationAlwaysAndWhenInUsePermission": "用于锁屏或切换应用后继续记录骑行轨迹。",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "@sfourdrinier/react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": ["central"],
          "bluetoothAlwaysPermission": "用于连接心率带、速度计和踏频传感器。"
        }
      ]
    ]
  }
}
